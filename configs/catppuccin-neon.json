    "actions": [],
    "copyFormatting": "none",
    "copyOnSelect": false,
    "defaultProfile": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
    "keybindings": [
        {
            "command": "copy",
            "keys": "ctrl+c"
        },
        {
            "command": "paste",
            "keys": "ctrl+v"
        },
        {
            "command": "splitPane",
            "keys": "alt+shift+d"
        },
        {
            "command": "newTab",
            "keys": "ctrl+shift+t"
        },
        {
            "command": "closeTab",
            "keys": "ctrl+shift+w"
        },
        {
            "command": "switchToTab",
            "keys": "alt+1"
        },
        {
            "command": "switchToTab",
            "keys": "alt+2"
        },
        {
            "command": "switchToTab",
            "keys": "alt+3"
        },
        {
            "command": "previousTab",
            "keys": "ctrl+shift+tab"
        },
        {
            "command": "nextTab",
            "keys": "ctrl+tab"
        }
    ],
    "newTabMenu": [
        {
            "type": "remainingProfiles"
        }
    ],
