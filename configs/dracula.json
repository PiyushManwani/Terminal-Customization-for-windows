{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "defaultProfile": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
    "keybindings": [
        {"command": "copy", "keys": "ctrl+c"},
        {"command": "paste", "keys": "ctrl+v"},
        {"command": "splitPane", "keys": "alt+shift+d"},
        {"command": "newTab", "keys": "ctrl+shift+t"},
        {"command": "closeTab", "keys": "ctrl+shift+w"},
        {"command": "switchToTab", "keys": "alt+1"},
        {"command": "switchToTab", "keys": "alt+2"},
        {"command": "switchToTab", "keys": "alt+3"},
        {"command": "previousTab", "keys": "ctrl+shift+tab"},
        {"command": "nextTab", "keys": "ctrl+tab"}
    ],
    "profiles": {
        "defaults": {
            "font": {
                "face": "JetBrainsMono Nerd Font Propo",
                "size": 12
            },
            "cursorShape": "bar",
            "cursorHeight": 30,
            "padding": "14, 14, 14, 14",
            "opacity": 85,
            "useAcrylic": true,
            "colorScheme": "Dracula"
        },
        "list": [
            {
                "commandline": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "name": "Windows PowerShell",
                "tabTitle": "PowerShell",
                "startingDirectory": "%USERPROFILE%"
            },
            {
                "commandline": "%SystemRoot%\\System32\\cmd.exe",
                "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
                "name": "Command Prompt",
                "tabTitle": "CMD",
                "startingDirectory": "%USERPROFILE%"
            },
            {
                "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
                "name": "PowerShell 7",
                "source": "Windows.Terminal.PowershellCore",
                "tabTitle": "PowerShell 7",
                "startingDirectory": "%USERPROFILE%"
            },
            {
                "guid": "{07b52e3e-de2c-5db4-bd2d-ba144dd330d3}",
                "name": "Ubuntu",
                "source": "Windows.Terminal.Wsl",
                "startingDirectory": "~"
            }
        ]
    },
